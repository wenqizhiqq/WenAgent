<Window x:Class="WenAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WenAgent - 本地 AI Agent"
        Width="1100" Height="780" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0B0E13"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2E5BFF"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4571FF"/>
        <SolidColorBrush x:Key="GhostBorderBrush" Color="#2A3446"/>
        <SolidColorBrush x:Key="GhostHoverBrush" Color="#1A2130"/>
        <SolidColorBrush x:Key="BodyBrush" Color="#E8ECF4"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8C95A6"/>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C6D0E0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource GhostBorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GhostHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F08A8A"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="#5A2B2F" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#231316"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#AEB8C8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="#11151C" BorderBrush="#3A4457" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M2,8 L6,12 L14,3"
                                      Stroke="#FFFFFF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#5B79B8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MessageTemplate">
            <Grid Margin="0,5">
                <Border x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="820"
                        CornerRadius="12" Padding="14,10"
                        Background="#151A23" BorderBrush="#222A38" BorderThickness="1"
                        ToolTip="{Binding FullContent}">
                    <StackPanel>
                        <TextBlock x:Name="HeaderText" Text="{Binding Header}" FontSize="10.5"
                                   Foreground="#7C879B" Margin="1,0,0,5" TextWrapping="Wrap"/>
                        <ScrollViewer x:Name="BodyScroll" VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="BodyText" Text="{Binding Content}" TextWrapping="Wrap"
                                       FontSize="13.5" LineHeight="21" Foreground="{StaticResource BodyBrush}"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="User">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="HeaderText" Property="Foreground" Value="#C9D4FF"/>
                    <Setter TargetName="HeaderText" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="BodyText" Property="Foreground" Value="#FFFFFF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Streaming">
                    <Setter TargetName="Bubble" Property="Background" Value="#0F141C"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#1E2A3C"/>
                    <Setter TargetName="HeaderText" Property="Foreground" Value="#6E87A8"/>
                    <Setter TargetName="BodyText" Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                    <Setter TargetName="BodyText" Property="FontSize" Value="12"/>
                    <Setter TargetName="BodyText" Property="Foreground" Value="#9FB0C7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Step">
                    <Setter TargetName="Bubble" Property="Background" Value="#0F1621"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#1C2B44"/>
                    <Setter TargetName="HeaderText" Property="Foreground" Value="#6F86A8"/>
                    <Setter TargetName="BodyText" Property="Foreground" Value="#8FA9D6"/>
                    <Setter TargetName="BodyText" Property="FontSize" Value="12.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Tool">
                    <Setter TargetName="Bubble" Property="Background" Value="#0C1714"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#1B3A30"/>
                    <Setter TargetName="Bubble" Property="MaxWidth" Value="880"/>
                    <Setter TargetName="HeaderText" Property="Foreground" Value="#5F9482"/>
                    <Setter TargetName="BodyText" Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                    <Setter TargetName="BodyText" Property="FontSize" Value="11.5"/>
                    <Setter TargetName="BodyText" Property="Foreground" Value="#A9D8C6"/>
                    <Setter TargetName="BodyScroll" Property="MaxHeight" Value="260"/>
                    <Setter TargetName="BodyScroll" Property="VerticalScrollBarVisibility" Value="Auto"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter TargetName="Bubble" Property="Background" Value="#2A1315"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#5A2427"/>
                    <Setter TargetName="HeaderText" Property="Foreground" Value="#D98A8A"/>
                    <Setter TargetName="BodyText" Property="Foreground" Value="#F0B4B4"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Info">
                    <Setter TargetName="Bubble" Property="Background" Value="Transparent"/>
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="0"/>
                    <Setter TargetName="Bubble" Property="Padding" Value="4"/>
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/>
                    <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="BodyText" Property="Foreground" Value="#76839A"/>
                    <Setter TargetName="BodyText" Property="FontSize" Value="11.5"/>
                    <Setter TargetName="BodyText" Property="TextAlignment" Value="Center"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#0C0F14" BorderBrush="#1B2130" BorderThickness="0,0,0,1"
                Padding="24,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="W" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WenAgent" FontSize="17" FontWeight="SemiBold" Foreground="#F2F5FA"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#8C95A6"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="正在启动…" Margin="6,0,0,0"
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="CommandCheck" Content="允许执行命令" IsChecked="True"
                              Style="{StaticResource DarkCheckBox}" Margin="0,0,18,0"
                              Checked="CommandCheck_Changed" Unchecked="CommandCheck_Changed"/>
                    <Button x:Name="NewChatButton" Content="新对话" Style="{StaticResource GhostButton}"
                            Click="NewChat_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 模型缺失提示 -->
        <Border x:Name="MissingPanel" Grid.Row="1" Visibility="Collapsed"
                Background="#241A12" BorderBrush="#5C3C1D" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock x:Name="MissingTitle" Text="未找到 GGUF 模型" FontSize="14"
                               FontWeight="SemiBold" Foreground="#F5C27A"/>
                    <TextBlock x:Name="MissingDetail" Margin="0,5,0,0" FontSize="12"
                               Foreground="#D8C5A8" TextWrapping="Wrap" LineHeight="19"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开下载页面" Style="{StaticResource AccentButton}" Padding="14,7"
                            FontSize="12" Click="OpenDownload_Click"/>
                    <Button Content="选择本地模型…" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="ChooseModel_Click"/>
                    <Button Content="重新搜索" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Click="Research_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 消息区 -->
        <ScrollViewer x:Name="ChatScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="24,10,24,10"
                      PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding Messages}"
                          ItemTemplate="{StaticResource MessageTemplate}"/>
        </ScrollViewer>

        <!-- 输入区 -->
        <Border Grid.Row="3" Background="#0C0F14" BorderBrush="#1B2130" BorderThickness="0,1,0,0"
                Padding="24,12,24,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#0B0E13" BorderBrush="#242C3B" BorderThickness="1"
                        CornerRadius="10" Height="78">
                    <Grid>
                        <TextBox x:Name="InputBox" Background="Transparent" BorderThickness="0"
                                 Foreground="#E8ECF4" CaretBrush="#E8ECF4" SelectionBrush="#2E5BFF"
                                 Padding="12,10" FontSize="13.5" AcceptsReturn="True" AcceptsTab="False"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 TextChanged="InputBox_TextChanged"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"/>
                        <TextBlock x:Name="InputPlaceholder" Margin="13,11,13,0"
                                   Text="描述任务，例如：把当前目录的文件列表整理成 report.md"
                                   Foreground="#4E5A70" FontSize="13" IsHitTestVisible="False"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="2,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10.5"
                               Foreground="#5A6478"
                               Text="Enter 发送 · Shift+Enter 换行 · 命令与写文件限制在工作目录内"/>
                    <Button x:Name="StopButton" Grid.Column="1" Content="停止"
                            Style="{StaticResource DangerButton}" MinWidth="78" Margin="0,0,8,0"
                            Click="Stop_Click" IsEnabled="False"/>
                    <Button x:Name="SendButton" Grid.Column="2" Content="发送"
                            Style="{StaticResource AccentButton}" MinWidth="92"
                            Click="Send_Click" IsEnabled="False"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
